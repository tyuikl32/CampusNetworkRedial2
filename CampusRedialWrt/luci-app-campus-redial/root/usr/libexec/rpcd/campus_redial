#!/usr/bin/env lua
-- rpcd exec plugin for OpenWrt 21.02: exposes the campus_redial ubus object.
-- rpcd runs this script with "list" (method signatures) or "call <method>"
-- (JSON args on stdin, JSON result on stdout).  luci.jsonc stringifies empty
-- Lua tables as [], so both branches rewrite the empty shapes to {} because
-- rpcd rejects anything but a table as a method signature or reply.

local json = require "luci.jsonc"
local fs   = require "nixio.fs"

local RUN_DIR   = "/var/run/campus-redial"
local DATA_DIR  = "/etc/campus-redial"
local STATUS_FILE = RUN_DIR .. "/status.json"
local LOG_FILE  = "/var/log/campus-redial.log"

local function readfile(path)
	local s = fs.readfile(path)
	return s and (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function parse_json(value)
	if not value or value == "" then
		return nil
	end
	local ok, result = pcall(json.parse, value)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

	local function status()
		local value = readfile(STATUS_FILE)
		if not value then
			return {
				running = false,
				state = "unavailable",
				normal = "unknown",
				mbps200 = "unknown",
				last_error = "后台服务尚未启动"
			}
		end

		local result = parse_json(value)
		if not result then
			-- The daemon replaces this file by rename, so a torn read window is
			-- measured in microseconds. nixio.fs has no sleep; a couple of cheap
			-- immediate re-reads clear the transient before the UI is told the
			-- file is broken.
			for _ = 1, 3 do
				value = readfile(STATUS_FILE)
				result = value and parse_json(value) or nil
				if result then break end
			end
		end
		if not result then
			return { running = false, state = "error", last_error = "状态文件损坏" }
		end

		local stats = parse_json(readfile(DATA_DIR .. "/stats.json"))
		local last  = parse_json(readfile(DATA_DIR .. "/last-run.json"))
		if stats then result.stats = stats end
		if last  then result.last_run = last end
		return result
	end

local function command(name)
	if name ~= "start" and name ~= "stop" and name ~= "test" and
	   name ~= "redial_once" and name ~= "clear_stats" then
		return { error = "Invalid command" }
	end

	local sys = require "luci.sys"
	if sys.call("/usr/sbin/campus-redialctl " .. name) == 0 then
		return { result = true }
	end
	return { error = "后台服务未运行" }
end

local function logs(args)
	local lines = tonumber(args.lines)
	if lines == nil then lines = 80 end
	if lines < 1 or lines > 200 then
		return { error = "lines must be between 1 and 200" }
	end

	local value = readfile(LOG_FILE)
	if not value or value == "" then
		return { logs = "" }
	end

	local tail = {}
	local count = 0
	for line in value:gmatch("[^\n]*") do
		count = count + 1
		table.insert(tail, line)
		if #tail > lines then
			table.remove(tail, 1)
		end
	end
	if count > 0 and tail[#tail] == "" then
		table.remove(tail)
	end
	return { logs = table.concat(tail, "\n") }
end

-- ------------------------------------------------------------------
-- SNI desync (zapret) integration. The daemon is installed by
-- tools/install-sni-desync.sh (see tools/SNI-DESYNC.md); when absent all
-- methods report installed=false and the UI renders a hint instead of
-- controls. hostlist lives in /opt/zapret/ipset/zapret-hosts-user.txt,
-- one domain suffix per line, '#' comments allowed.
-- ------------------------------------------------------------------
local ZAPRET_DIR   = "/opt/zapret"
local ZAPRET_LIST  = ZAPRET_DIR .. "/ipset/zapret-hosts-user.txt"
local ZAPRET_INIT  = "/etc/init.d/zapret"
-- `zapret enable` 生成的启动软链：存在 = 开机自启。
local ZAPRET_RC    = "/etc/rc.d/S21zapret"
-- "停止"标记：存在时 /etc/firewall.zapret 不再安装 tpws 跳转。
-- 放在 /var/run（tmpfs）——重启即失效，返回默认的“开启”状态。
local ZAPRET_OFF_FLAG = "/var/run/zapret.off"

local function zapret_installed()
	return fs.stat(ZAPRET_DIR) ~= nil
end

local function zapret_running()
	local sys = require "luci.sys"
	-- 注意：不要用 `pgrep -f 'tpws|nfqws'`。luci.sys.exec 会经由
	-- `/bin/sh -c "<cmd>"` 执行，而那条 shell 自己的命令行里就含 "tpws"，
	-- pgrep -f 会匹配到自己 → 无论守护进程是否在跑都返回“在运行”。
	-- 改用 pidof/tool 按进程名精确匹配（shell 的进程名是 sh，不会自我匹配）。
	local out = sys.exec("pidof tpws 2>/dev/null; pidof nfqws 2>/dev/null")
	return out ~= nil and out:match("%d") ~= nil
end

local function zapret_mode()
	local cfg = readfile("/opt/zapret/config") or ""
	if cfg:find("TPWS_ENABLE=1", 1, true) then
		return "tpws"
	elseif cfg:find("NFQWS_ENABLE=1", 1, true) then
		return "nfqws"
	end
	return "unknown"
end

local function zapret_hostlist_read()
	local value = readfile(ZAPRET_LIST)
	if not value then
		return nil
	end
	local entries = {}
	for line in value:gmatch("[^\r\n]+") do
		line = (line:gsub("%s+", ""))
		if line ~= "" and line:sub(1, 1) ~= "#" then
			table.insert(entries, line)
		end
	end
	return entries
end

local function zapret_status()
	if not zapret_installed() then
		return { installed = false, running = false, mode = "none" }
	end
	local sys = require "luci.sys"
	local result = {
		installed = true,
		running   = zapret_running(),
		mode      = zapret_mode(),
		enabled   = fs.access(ZAPRET_RC) ~= nil
	}
	-- 流量接管有两种形态，必须按模式分别判定。历史缺陷：这里只查 nat 跳转，
	-- 于是 nfqws 模式（没有 nat 跳转、靠 mangle NFQUEUE）被永久误报成
	-- “运行中（未接管流量）”、DNAT 命中恒为 0，点“启动/重启”也看不出变化。
	--   tpws  : nat PREROUTING/OUTPUT 把 LAN 80/443 DNAT 到 127.0.0.127:988
	--   nfqws : mangle 把每连接前几个包送进 NFQUEUE（--queue-num 200）
	local natline = tostring(sys.exec(
		"iptables -t nat -L PREROUTING -v -n 2>/dev/null | grep -m1 '127.0.0.127:988'"))
	result.nat_redirect   = natline:match("127%.0%.0%.127:988") ~= nil
	result.redirect_pkts  = natline:match("^%s*(%d+)") or "0"
	result.redirect_bytes = natline:match("^%s*%d+%s+(%d+)") or "0"

	local nf_rules, nf_pkts, nf_bytes = 0, 0, 0
	do
		local rules_out = tostring(sys.exec("iptables -t mangle -S 2>/dev/null | grep -c NFQUEUE"))
		nf_rules = tonumber(rules_out:match("%d+")) or 0
	end
	do
		-- 三条链都要算：出向 POSTROUTING、入向 FORWARD / INPUT
		local out = tostring(sys.exec(
			"for c in POSTROUTING FORWARD INPUT; do " ..
			"iptables -t mangle -L \"$c\" -v -n 2>/dev/null; done"))
		for l in out:gmatch("[^\r\n]+") do
			if l:find("NFQUEUE", 1, true) then
				local p, b = l:match("^%s*(%d+)%s+(%d+)")
				if p then
					nf_pkts  = nf_pkts  + (tonumber(p) or 0)
					nf_bytes = nf_bytes + (tonumber(b) or 0)
				end
			end
		end
	end
	result.nfqueue_rules = nf_rules
	result.nfqueue_pkts  = nf_pkts
	result.nfqueue_bytes = nf_bytes

	-- 统一口径：redirect = 当前模式下“流量确实被接管”；hit_* = 当前形态的命中量。
	-- running 与 redirect 不一致就是故障态：running 而 !redirect 说明分流没接上；
	-- !running 而 redirect 在 tpws 下是跳转残留（所有网页 connection refused，
	-- 连本面板也打不开），在 nfqws 下只是规则还在（带 --queue-bypass，不会黑洞）。
	if result.mode == "nfqws" then
		result.redirect      = nf_rules > 0
		result.redirect_kind = result.redirect and "nfqueue" or "none"
		result.hit_pkts      = nf_pkts
		result.hit_bytes     = nf_bytes
	else
		result.redirect      = result.nat_redirect
		result.redirect_kind = result.redirect and "nat" or "none"
		result.hit_pkts      = tonumber(result.redirect_pkts) or 0
		result.hit_bytes     = tonumber(result.redirect_bytes) or 0
	end

	result.off      = fs.access(ZAPRET_OFF_FLAG) ~= nil
	local hosts = zapret_hostlist_read() or {}
	result.hostlist_count = #hosts
	-- 实测语义：hostlist 文件存在但为空 = 匹配所有主机（对所有域名做 desync）。
	-- 面板必须把这点说清楚，否则“名单域名数 0”会被读成“分流没生效”。
	result.hostlist_all = #hosts == 0
	result.updated_at = os.date("%Y-%m-%d %H:%M:%S")
	return result
end

local function zapret_hostlist_read_method()
	local hosts = zapret_hostlist_read()
	if hosts == nil then
		return { error = "无法读取 hostlist（zapret 未安装？）" }
	end
	return { hostlist = table.concat(hosts, "\n"), installed = true }
end

-- SNI 分流的“开 / 关”必须同时管理两层状态，缺一不可：
--   1) tpws 守护进程（procd 实例）
--   2) nat PREROUTING/OUTPUT 上把 LAN 80/443 DNAT 到 127.0.0.127:988 的跳转
-- 历史缺陷：旧实现只做 (1)。停掉 tpws 后跳转仍在，所有经 br-lan 的 80/443
-- 都指向已关闭端口 → 客户端一律 connection refused；而 LuCI 面板自己也在
-- 80 端口，于是连管理页都打不开，看起来就像“死机”。
-- 现在的顺序（stop）：
--   touch /var/run/zapret.off  → 让 /etc/firewall.zapret 在 fw3 重载时不再补回跳转
--   /etc/init.d/zapret stop_fw → 摘掉跳转（此刻起流量直连，网络恢复）
--   /etc/init.d/zapret stop    → 停守护进程
-- 之所以先摘跳转再停进程：避免出现“跳转到死端口”的时间窗口。
-- 启动侧相反：先起进程，再补跳转（避免“有跳转无监听”）。
--
-- 语义：**仅运行时停止**，与 OpenWrt 原生 `stop` 一致 —— 不 disable 服务，
-- 所以重启后自动恢复为开启。/var/run 是 tmpfs，标记也随重启失效。
local function zapret_apply_action(action)
	local sys = require "luci.sys"
	local cmd
	if action == "stop" then
		cmd = "touch " .. ZAPRET_OFF_FLAG ..
			"; " .. ZAPRET_INIT .. " stop_fw" ..
			"; " .. ZAPRET_INIT .. " stop"
	elseif action == "restart" then
		cmd = "rm -f " .. ZAPRET_OFF_FLAG ..
			"; " .. ZAPRET_INIT .. " restart" ..
			"; " .. ZAPRET_INIT .. " restart_fw"
	else
		cmd = "rm -f " .. ZAPRET_OFF_FLAG ..
			"; " .. ZAPRET_INIT .. " start" ..
			"; " .. ZAPRET_INIT .. " start_fw"
	end
	-- 整条有序命令后台执行：既不阻塞 ubus 响应（uhttpd 的 chunked 连接在
	-- init 脚本静默数秒后会被掐断，客户端收到 IncompleteRead），又保证
	-- touch → stop_fw → stop 的先后顺序。前端会在随后 1.2s / 3.2s 轮询状态。
	sys.call("( " .. cmd .. " ) >/dev/null 2>&1 &")
end

local function zapret_hostlist_write(args)
	if not zapret_installed() then
		return { error = "zapret 未安装" }
	end
	local content = tostring(args.hostlist or "")
	-- 域名/注释白名单：字母数字点连字符、'#' 注释、空白
	local lines = {}
	for line in content:gmatch("[^\n]+") do
		line = line:gsub("%s+$", ""):gsub("^%s+", "")
		if line ~= "" then
			if line:sub(1, 1) == "#" then
				-- keep comments
			elseif not line:match("^[A-Za-z0-9%-%.%*]+$") then
				return { error = "非法域名行: " .. line }
			end
			table.insert(lines, line)
		end
	end
	local fh = io.open("/opt/zapret/ipset/zapret-hosts-user.txt", "w")
	if not fh then
		return { error = "无法写入 hostlist 文件" }
	end
	fh:write(table.concat(lines, "\n") .. (#lines > 0 and "\n" or ""))
	fh:close()
	-- 保存名单 = 明确要启用分流：走 restart（会清停止标记 + 重启进程 + 补跳转），
	-- 否则用户先“停止”再保存名单会得到“进程在跑但流量没接管”的错位状态。
	zapret_apply_action("restart")
	return { result = true, count = #lines, installed = true }
end

local function zapret_service(args)
	local action = tostring(args.action or "")
	if action ~= "restart" and action ~= "start" and action ~= "stop" then
		return { error = "action 必须是 restart/stop/start" }
	end
	if not zapret_installed() then
		return { error = "zapret 未安装" }
	end
	zapret_apply_action(action)
	return { result = true, action = action }
end

-- 开机自启（面板上的复选框）。语义刻意与「启动/停止」分离：
--   * 这里只管开机行为：`/etc/init.d/zapret enable|disable` 增删 /etc/rc.d/S21zapret；
--   * **不动**当前进程——取消自启不会把正在跑的分流停掉（那是“停止”按钮的事），
--     勾上自启也不会立刻启动（避免用户只想改开机行为却被重启一次连接）。
-- 注意两处联动：
--   1) /var/run/zapret.off 是 tmpfs，重启即失效；所以“取消自启 + 停止”才是彻底不再启动。
--   2) /etc/firewall.zapret 的守卫按“自启软链存在 or 进程在跑”判断要不要补接管规则，
--      因此取消自启后的一次 fw3 reload 不会把正在生效的规则悄悄摘掉。
local function zapret_autostart_set(args)
	if not zapret_installed() then
		return { error = "zapret 未安装" }
	end
	local want = tostring(args.enable or "")
	local cmd
	if want == "1" or want == "true" then
		cmd = ZAPRET_INIT .. " enable"
	elseif want == "0" or want == "false" then
		cmd = ZAPRET_INIT .. " disable"
	else
		return { error = "enable 必须是 1 或 0" }
	end
	local sys = require "luci.sys"
	-- enable/disable 只动一个软链，很快；同步执行以便把真实结果回给前端。
	sys.call(cmd .. " >/dev/null 2>&1")
	local enabled = fs.access(ZAPRET_RC) ~= nil
	-- 期望值与实际不符时明确报错，而不是让面板显示一个“点了没用”的状态。
	if (want == "1" or want == "true") ~= enabled then
		return { error = "设置失败：/etc/rc.d/S21zapret 未按预期变化（检查 /etc/init.d/zapret 是否存在）" }
	end
	return { result = true, enabled = enabled }
end

local methods = {
	status = {
		call = function()
			return status()
		end
	},
	start = {
		call = function()
			return command("start")
		end
	},
	stop = {
		call = function()
			return command("stop")
		end
	},
	test = {
		call = function()
			return command("test")
		end
	},
	redial_once = {
		call = function()
			return command("redial_once")
		end
	},
	clear_stats = {
		call = function()
			return command("clear_stats")
		end
	},
	logs = {
		args = { lines = 0 },
		call = logs
	},
	zapret_status = {
		call = function()
			return zapret_status()
		end
	},
	zapret_hostlist_get = {
		call = function()
			return zapret_hostlist_read_method()
		end
	},
	zapret_hostlist_set = {
		args = { hostlist = "" },
		call = zapret_hostlist_write
	},
	zapret_service = {
		args = { action = "" },
		call = zapret_service
	},
	-- 开机自启：args 用字符串（ubus/LuCI 21.02 的位置参数只传简单类型）
	zapret_autostart = {
		args = { enable = "" },
		call = zapret_autostart_set
	}
}

if arg[1] == "list" then
	local rv = {}
	for name, method in pairs(methods) do
		rv[name] = method.args or {}
	end
	print((json.stringify(rv):gsub(":%[%]", ":{}")))
elseif arg[1] == "call" then
	local parse = json.new()
	local done, err

	while true do
		local chunk = io.read(4096)
		if not chunk then
			break
		elseif not done and not err then
			done, err = parse:parse(chunk)
		end
	end

	if not done then
		print(json.stringify({ error = err or "Incomplete input" }))
		os.exit(1)
	end

	local uargs = parse:get()
	local method = methods[arg[2]]
	if not method then
		print(json.stringify({ error = "Method not found" }))
		os.exit(1)
	end

	if type(uargs) ~= "table" then
		print(json.stringify({ error = "Invalid arguments" }))
		os.exit(1)
	end

	uargs.ubus_rpc_session = nil

	local margs = method.args or {}
	for k, v in pairs(uargs) do
		if margs[k] == nil or (v ~= nil and type(v) ~= type(margs[k])) then
			print(json.stringify({ error = "Invalid arguments" }))
			os.exit(1)
		end
	end

	local result = method.call(uargs)
	print((json.stringify(result):gsub("^%[%]$", "{}")))
	os.exit(0)
end
