#!/bin/sh
# Generate the mwan3 configuration for the campus-redial connection pool in
# mwan3 2.10.x format (OpenWrt 21.02). All pool sessions are equal-weight
# members; traffic is distributed per connection. Never reloads mwan3 itself.
#
# Section names stay within mwan3 2.10's 15-character iptables chain limit:
# policy cr_balanced, rule cr_default_ipv4, members cr_wan<N>_member.

POOL_SIZE=${1:-1}
case "$POOL_SIZE" in
	''|*[!0-9]*) POOL_SIZE=1 ;;
esac
[ "$POOL_SIZE" -ge 1 ] && [ "$POOL_SIZE" -le 24 ] || POOL_SIZE=1

interfaces=""
policy_members=""
members_block=""

i=1
while [ "$i" -le "$POOL_SIZE" ]; do
	if [ "$i" -eq 1 ]; then ifname=wan; else ifname="wan$i"; fi
	mwan_member="cr_wan_member"
	[ "$i" -eq 1 ] || mwan_member="cr_wan${i}_member"
	if [ "$i" -eq 1 ]; then managed_line=""; else managed_line="    option campus_redial_managed '1'"; fi
	interfaces="$interfaces
config interface '$ifname'
$managed_line
	option enabled '1'
	option family 'ipv4'
	list track_ip '223.5.5.5'
	list track_ip '114.114.114.114'
	list track_ip '119.29.29.29'
	list track_ip '180.76.76.76'
	option reliability '1'
"
	policy_members="$policy_members
	list use_member '$mwan_member'"
	members_block="$members_block
config member '$mwan_member'
	option interface '$ifname'
	option metric '1'
	option weight '1'
"
	i=$((i + 1))
done

cat <<EOF
# Generated by campus-redial-mwan3 for the campus-redial connection pool.
# mwan3 2.10.x format (OpenWrt 21.02); all sessions are equal-weight and
# traffic is distributed per connection. Names fit the 15-character
# iptables chain limit of mwan3 2.10.x.

$interfaces

$members_block
config policy 'cr_balanced'
$policy_members

config rule 'cr_default_ipv4'
	option dest_ip '0.0.0.0/0'
	option proto 'all'
	option family 'ipv4'
	option use_policy 'cr_balanced'
EOF
