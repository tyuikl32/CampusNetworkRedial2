#!/bin/sh

set -eu

RUN_DIR=/var/run/campus-redial
CONTROL="$RUN_DIR/control"

case "${1:-}" in
	start|stop|test|redial_once|clear_stats)
		command_name=$1
		;;
	*)
		echo "invalid command" >&2
		exit 2
		;;
esac

# A fresh install or an inactive procd service leaves no daemon to consume the
# control record. Bring the service up first; start_service is a no-op when it
# is already running, so this is safe to repeat on every command.
if [ "$command_name" != stop ] || [ -x /etc/init.d/campus-redial ]; then
	if ! /etc/init.d/campus-redial status >/dev/null 2>&1; then
		/etc/init.d/campus-redial start >/dev/null 2>&1 || true
		# Give the daemon a moment to create the run directory.
		sleep 1
	fi
fi

mkdir -p "$RUN_DIR"
umask 077
tmp="$RUN_DIR/control.$$"
printf '%s\n' "$command_name" > "$tmp"
mv -f "$tmp" "$CONTROL"
exit 0
