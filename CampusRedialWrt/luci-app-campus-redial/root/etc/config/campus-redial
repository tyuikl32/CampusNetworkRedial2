config campus_redial 'main'
	option enabled '1'
	option wan_interface 'wan'
	option wan_device ''
	option pppoe_username ''
	option pppoe_password ''
	option pool_size '1'
	option pool_keepalive '1'
	option auth_interval_seconds '60'
	option busy_threshold_kbytes '0'
	option normal_enabled '1'
	option mbps200_enabled '1'
	option bandwidth_test_uri 'https://test.xidian.edu.cn/backend/garbage.php'
	option bandwidth_test_seconds '5'
	option bandwidth_threshold_mbps '150'
	option timeout_seconds '4'
	option probe_count '3'
	option confirm_interval_seconds '12'
	option third_interval_seconds '30'
	option pause_seconds '2'
	option settle_seconds '10'
	option max_attempts '99'
	list probe_uri 'https://abvolcapi.douyucdn.cn/'
	list probe_uri 'https://apiv2.douyucdn.cn/'

# Optional multi-account pool entries. When at least one enabled account is
# filled, the sum of max_connections becomes the pool size and the legacy
# pppoe_username/pppoe_password fields are ignored.
config account 'account1'
	option label '账号 1'
	option username ''
	option password ''
	option max_connections '1'
	option enabled '0'
